# Names of the environment variables FlakyHunter reads.
# Real values live only in Render / Vercel settings — never in git.

# PostgreSQL (Neon). JDBC form, without user/password in it:
# jdbc:postgresql://<host>/<database>?sslmode=require
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Long random string used to sign login tokens (Phase 1)
JWT_SECRET=

# Public address of the website, e.g. https://flakyhunter.vercel.app
APP_BASE_URL=

# true = load the public demo project
DEMO_MODE=false
